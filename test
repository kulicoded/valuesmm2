local function GetGroup(win, name)
	for _, g in ipairs(win._groups) do
		if g.Name == name then return g end
	end
	local index = #win._groups + 1
	local g = { Name = name, Index = index, Count = 0 }

	g.Separator = New("Frame", {
		Size = UDim2.new(1, 0, 0, 17), -- 8 + линия 1 + 8
		BackgroundTransparency = 1,
		LayoutOrder = index * 1000 - 1,
		Visible = (index > 1) and not win.RailOpen,
		ZIndex = 5,
		Parent = win._railItems,
	})
	New("Frame", {
		Size = UDim2.fromOffset(24, 1),
		Position = UDim2.fromOffset(20, 8),
		BackgroundColor3 = Theme.stroke,
		BorderSizePixel = 0,
		ZIndex = 5,
		Parent = g.Separator,
	})

	g.Header = New("TextLabel", {
		Size = UDim2.new(1, 0, 0, 22),
		BackgroundTransparency = 1,
		Font = Theme.FontMedium,
		TextSize = 11,
		TextColor3 = Theme.text3,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTransparency = win.RailOpen and 0 or 1,
		Text = Spaced(Upper(name)),
		LayoutOrder = index * 1000,
		Visible = win.RailOpen,
		ZIndex = 5,
		Parent = win._railItems,
	})
	Pad(g.Header, 5, 0, 0, 24)

	table.insert(win._groups, g)
	return g
end

function Window:AddTab(o)
	o = o or {}
	local win = self
	local group = GetGroup(win, o.Group or "")
	group.Count += 1

	local tab = setmetatable({
		_win = win, Name = o.Name, _cards = {}, _columns = {},
	}, Tab)

	------------------------------ пункт рейла ---------------------------
	local item = New("TextButton", {
		Size = UDim2.new(1, 0, 0, L.railItemH),
		BackgroundColor3 = Theme.bg2,
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		Text = "",
		BorderSizePixel = 0,
		LayoutOrder = group.Index * 1000 + group.Count,
		ZIndex = 5,
		Parent = win._railItems,
	})

	local bar = New("Frame", {
		Size = UDim2.new(0, 2, 1, -12),
		Position = UDim2.fromOffset(0, 6),
		BackgroundColor3 = win.Accent,
		BorderSizePixel = 0,
		Visible = false,
		ZIndex = 5,
		Parent = item,
	})
	Corner(bar, 1)
	MarkAccent(win, bar, "BackgroundColor3")

	-- иконка стоит на x=24 в обоих состояниях рейла и не двигается при анимации
	local iconX = isMobile and math.floor((L.railW - L.railIcon) / 2) or 24
	local icon = Icon(o.Icon or "", L.railIcon, Theme.text2, {
		Position = UDim2.fromOffset(iconX, math.floor((L.railItemH - L.railIcon) / 2)),
		ZIndex = 5,
		Parent = item,
	})

	local label = New("TextLabel", {
		Size = UDim2.new(1, -56, 0, 16),
		Position = UDim2.fromOffset(56, math.floor((L.railItemH - 16) / 2)),
		BackgroundTransparency = 1,
		Font = Theme.Font,
		TextSize = 13,
		TextColor3 = Theme.text1,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTransparency = win.RailOpen and 0 or 1,
		Text = o.Name or "",
		ZIndex = 5,
		Parent = item,
	})

	tab.RailItem, tab.RailIcon, tab.RailLabel, tab.RailBar = item, icon, label, bar

	------------------------------- страница -----------------------------
	local page = New("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 2, -- НЕ ЗАДАНО В СПЕЦИФИКАЦИИ
		ScrollBarImageColor3 = Theme.stroke,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Visible = false,
		ZIndex = 2,
		Parent = win._pages,
	})
	tab.Page = page

	if o.Type == "Configs" then
		tab.IsConfigs = true
		win:_BuildConfigsPage(tab)
	else
		local colW = (L.columns == 1) and UDim2.new(1, 0, 0, 0)
			or UDim2.new(0.5, -L.gridGap / 2, 0, 0)
		for c = 1, L.columns do
			local col = New("Frame", {
				Size = colW,
				AutomaticSize = Enum.AutomaticSize.Y,
				Position = (c == 1) and UDim2.new()
					or UDim2.new(0.5, L.gridGap / 2, 0, 0),
				BackgroundTransparency = 1,
				ZIndex = 2,
				Parent = page,
			})
			ListLayout(col, Enum.FillDirection.Vertical, L.gridGap)
			table.insert(tab._columns, col)
		end
	end

	--------------------------- поведение пункта -------------------------
	Connect(item.MouseEnter, function()
		if win.ActiveTab ~= tab then
			Tween(item, { BackgroundTransparency = 0 }, 0.12)
		end
	end)
	Connect(item.MouseLeave, function()
		if win.ActiveTab ~= tab then
			Tween(item, { BackgroundTransparency = 1 }, 0.12)
		end
	end)
	Connect(item.MouseButton1Click, function() win:SelectTab(tab) end)

	table.insert(win._tabs, tab)
	if not win.ActiveTab then win:SelectTab(tab) end
	return tab
end

function Window:SelectTab(tab)
	for _, t in ipairs(self._tabs) do
		local active = (t == tab)
		t.Page.Visible = active
		t.RailItem.BackgroundTransparency = active and 0 or 1
		t.RailBar.Visible = active
		t.RailLabel.TextColor3 = active and Theme.text0 or Theme.text1
		t.RailLabel.Font = active and Theme.FontMedium or Theme.Font
		IconColor(t.RailIcon, active and Theme.text0 or Theme.text2)
	end
	self.ActiveTab = tab
	self:_ApplySearch()
end

