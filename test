------------------------------- Row / Card -----------------------------

local function AddRow(win, card, labelText, secondary)
	local row = { Height = L.rowH, UserVisible = true, Text = labelText or "" }

	row.Frame = New("Frame", {
		Size = UDim2.new(1, 0, 0, L.rowH),
		BackgroundTransparency = 1,
		LayoutOrder = #card._rows + 2,
		Parent = card.Frame,
	})
	row.Label = New("TextLabel", {
		Size = UDim2.new(1, -140, 1, 0),
		BackgroundTransparency = 1,
		Font = Theme.Font,
		TextSize = L.fontRow,
		TextColor3 = secondary and Theme.text1 or Theme.text0,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Text = labelText or "",
		Parent = row.Frame,
	})
	row.Control = New("Frame", {
		Size = UDim2.new(0, 200, 1, 0),
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		BackgroundTransparency = 1,
		Parent = row.Frame,
	})

	function row:SetVisible(b)
		self.UserVisible = b and true or false
		self.Frame.Visible = self.UserVisible
	end

	table.insert(card._rows, row)
	return row
end

local Card = {}
Card.__index = Card

function Card:AddToggle(opts)   return MakeToggle(self._win,   AddRow(self._win, self, opts.Name), opts) end
function Card:AddSlider(opts)   return MakeSlider(self._win,   AddRow(self._win, self, opts.Name), opts) end
function Card:AddDropdown(opts) return MakeDropdown(self._win, AddRow(self._win, self, opts.Name), opts) end
function Card:AddButton(opts)   return MakeButton(self._win,   AddRow(self._win, self, opts.Name), opts) end
function Card:AddTextbox(opts)  return MakeTextbox(self._win,  AddRow(self._win, self, opts.Name), opts) end
function Card:AddKeybind(opts)  return MakeKeybind(self._win,  AddRow(self._win, self, opts.Name), opts) end

local Tab = {}
Tab.__index = Tab

function Tab:AddCard(opts)
	local win = self._win
	local col = self._columns[(#self._cards % L.columns) + 1]

	local card = setmetatable({ _win = win, _rows = {} }, Card)
	card.Frame = New("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Theme.bg2,
		BorderSizePixel = 0,
		LayoutOrder = #self._cards + 1,
		Parent = col,
	})
	Corner(card.Frame, L.cardRadius or win.Radius)
	Stroke(card.Frame)
	Pad(card.Frame, L.cardPad, L.cardPad, L.cardPad, L.cardPad)
	ListLayout(card.Frame, Enum.FillDirection.Vertical, L.cardRowGap)

	card.Title = New("TextLabel", {
		Size = UDim2.new(1, 0, 0, 16),
		BackgroundTransparency = 1,
		Font = Theme.FontMedium,
		TextSize = L.fontRow,
		TextColor3 = Theme.text0,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = opts.Name or "",
		LayoutOrder = 1,
		Parent = card.Frame,
	})

	table.insert(self._cards, card)
	return card
end

