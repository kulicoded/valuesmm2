		if i.KeyCode ~= win.ToggleKey then return end
		if UserInputService:GetFocusedTextBox() ~= nil then return end
		win:Toggle()
	end)

	-- перетаскивание за шапку, с ограничением по экрану
	do
		local dragging, startPos, startCenter = false, nil, nil
		Connect(header.InputBegan, function(i)
			if i.UserInputType == Enum.UserInputType.MouseButton1
			or i.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				startPos = i.Position
				startCenter = win.Root.AbsolutePosition + win.Root.AbsoluteSize / 2
			end
		end)
		Connect(UserInputService.InputChanged, function(i)
			if not dragging then return end
			if i.UserInputType ~= Enum.UserInputType.MouseMovement
			and i.UserInputType ~= Enum.UserInputType.Touch then return end
			local delta = i.Position - startPos
			local screen = win.Gui.AbsoluteSize
			local half = win.Root.AbsoluteSize / 2
			local cx = Clamp(startCenter.X + delta.X, half.X, math.max(half.X, screen.X - half.X))
			local cy = Clamp(startCenter.Y + delta.Y, half.Y, math.max(half.Y, screen.Y - half.Y))
			win.Root.Position = UDim2.fromOffset(cx, cy)
		end)
		Connect(UserInputService.InputEnded, function(i)
			if i.UserInputType == Enum.UserInputType.MouseButton1
			or i.UserInputType == Enum.UserInputType.Touch then
				dragging = false
			end
		end)
	end

	-- рейл: разворот / сворачивание
	if win.RailToggleBtn then
		Connect(win.RailToggleBtn.MouseButton1Click, function() win:ToggleRail() end)
	end
	Connect(win.Dim.InputBegan, function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1
		or i.UserInputType == Enum.UserInputType.Touch then
			win:ToggleRail(false)
		end
	end)

	-- поиск
	Connect(win.Search:GetPropertyChangedSignal("Text"), function() win:_ApplySearch() end)

	table.insert(Library._windows, win)
	return win
end

