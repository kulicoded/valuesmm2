function Window:_ApplySearch()
	local tab = self.ActiveTab
	if not tab or not tab._cards then return end
	local q = string.lower(self.Search.Text)
	for _, card in ipairs(tab._cards) do
		local any = false
		for _, row in ipairs(card._rows) do
			local match = (q == "") or (string.find(string.lower(row.Text), q, 1, true) ~= nil)
			row.Frame.Visible = row.UserVisible and match
			if row.Frame.Visible then any = true end
		end
		card.Frame.Visible = any
	end
end

function Window:SetLogo(assetId)
	self.LogoValue = assetId or ""
	if not self.LogoSlot then return end -- на мобильной раскладке слота нет
	for _, c in ipairs(self.LogoSlot:GetChildren()) do
		if c:IsA("TextLabel") or c:IsA("ImageLabel") then c:Destroy() end
	end
	if self.LogoValue ~= "" then
		local img = New("ImageLabel", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			ScaleType = Enum.ScaleType.Fit,
			Image = self.LogoValue, -- подставляется как есть
			Parent = self.LogoSlot,
		})
		Corner(img, 6)
	else
		local letter = self.LogoText
		if letter == "" or letter == nil then
			-- первая буква Name; string.sub взял бы один байт и разрезал кириллицу
			letter = ""
			for _, c in utf8.codes(self.Name) do
				letter = utf8.char(c)
				break
			end
		end
		local lbl = New("TextLabel", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Font = Theme.FontBold,
			TextSize = 11,
			TextColor3 = self.Accent,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextYAlignment = Enum.TextYAlignment.Center,
			Text = Upper(letter),
			Parent = self.LogoSlot,
		})
		MarkAccent(self, lbl, "TextColor3")
	end
end

function Window:SetName(name, version)
	self.Name = name or self.Name
	self.Version = version or self.Version
	if self.NameLabel then self.NameLabel.Text = self.Name end
	if self.VerLabel then self.VerLabel.Text = self.Version end
	self.WmName.Text = self.Name
	if self.LogoValue == "" then self:SetLogo("") end
end

function Window:SetAccent(color)
	self.Accent = color
	for _, e in ipairs(self._accent) do
		if e.inst.Parent then e.inst[e.prop] = color end
	end
end

function Window:SetWatermark(state)
	-- В спецификации метода нет, но ватермарк требуется включать отдельно от панели.
	self.Watermark.Visible = state and true or false
end

