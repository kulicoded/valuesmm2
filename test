function Window:ToggleRail(state)
	if isMobile then return end -- на мобильной раскладке рейл всегда свёрнут
	if state == nil then state = not self.RailOpen end
	if state == self.RailOpen then return end
	self.RailOpen = state

	if state then
		-- разворот 64 -> 180 за 0.16, подписи с задержкой 0.04, затемнение за 0.12
		self.RailLine.Visible = true
		for _, g in ipairs(self._groups) do
			g.Separator.Visible = false
			g.Header.Visible = true
		end
		Tween(self.Rail, { Size = UDim2.new(0, L.railWExp, 1, 0) }, 0.16)
		self.Dim.Visible = true
		Tween(self.Dim, { BackgroundTransparency = 0.55 }, 0.12)
		task.delay(0.04, function()
			if not self.RailOpen then return end
			for _, t in ipairs(self._tabs) do
				Tween(t.RailLabel, { TextTransparency = 0 }, 0.12)
			end
			for _, g in ipairs(self._groups) do
				Tween(g.Header, { TextTransparency = 0 }, 0.12)
			end
		end)
		if self.RailToggleIcon then
			IconColor(self.RailToggleIcon, Theme.text2)
		end
	else
		-- сворачивание: подписи гаснут первыми, затем едет ширина
		for _, t in ipairs(self._tabs) do
			Tween(t.RailLabel, { TextTransparency = 1 }, 0.06)
		end
		for _, g in ipairs(self._groups) do
			Tween(g.Header, { TextTransparency = 1 }, 0.06)
		end
		Tween(self.Dim, { BackgroundTransparency = 1 }, 0.12)
		task.delay(0.12, function()
			if self.RailOpen then return end
			self.Dim.Visible = false
		end)
		task.delay(0.06, function()
			if self.RailOpen then return end
			Tween(self.Rail, { Size = UDim2.new(0, L.railW, 1, 0) }, 0.14)
			for i, g in ipairs(self._groups) do
				g.Header.Visible = false
				g.Separator.Visible = (i > 1)
			end
			task.delay(0.14, function()
				if not self.RailOpen then self.RailLine.Visible = false end
			end)
		end)
	end
end

