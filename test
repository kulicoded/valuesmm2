--------------------------------- TOGGLE -------------------------------
local function MakeToggle(win, row, opts)
	local ctl = {}
	local value = opts.Default == true
	local id = opts.Flag or opts.Name

	local body = New("TextButton", {
		Size = UDim2.fromOffset(L.togW, L.togH),
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		BackgroundColor3 = value and win.Accent or Theme.bg1,
		AutoButtonColor = false,
		Text = "",
		BorderSizePixel = 0,
		Parent = row.Control,
	})
	Corner(body, 9)
	local st = Stroke(body)
	st.Transparency = value and 1 or 0

	local knob = New("Frame", {
		Size = UDim2.fromOffset(L.togKnob, L.togKnob),
		BackgroundColor3 = value and Theme.knob or Theme.text2,
		BorderSizePixel = 0,
		Position = value
			and UDim2.fromOffset(L.togW - L.togKnob - 2, L.togOnY)
			or UDim2.fromOffset(2, L.togOffY),
		Parent = body,
	})
	Round(knob)

	local function render(animate)
		local dur = animate and 0.12 or 0
		local pos = value
			and UDim2.fromOffset(L.togW - L.togKnob - 2, L.togOnY)
			or UDim2.fromOffset(2, L.togOffY)
		if animate then
			Tween(body, { BackgroundColor3 = value and win.Accent or Theme.bg1 }, dur)
			Tween(knob, { Position = pos, BackgroundColor3 = value and Theme.knob or Theme.text2 }, dur)
			Tween(st, { Transparency = value and 1 or 0 }, dur)
		else
			body.BackgroundColor3 = value and win.Accent or Theme.bg1
			knob.Position = pos
			knob.BackgroundColor3 = value and Theme.knob or Theme.text2
			st.Transparency = value and 1 or 0
		end
	end

	function ctl:Set(v, silent)
		v = v == true
		if v == value then return end
		value = v
		Library.Flags[id] = value
		render(true)
		if not silent and opts.Callback then opts.Callback(value) end
	end
	function ctl:Get() return value end
	function ctl:SetVisible(b) row:SetVisible(b) end

	Connect(body.MouseButton1Click, function()
		ctl:Set(not value)
	end)

	Library.Flags[id] = value
	win._controls[id] = ctl
	return ctl
end

--------------------------------- SLIDER -------------------------------
local function MakeSlider(win, row, opts)
	local ctl = {}
	local min, max = opts.Min or 0, opts.Max or 100
	local step = opts.Step or 1
	local value = Clamp(opts.Default or min, min, max)
	local id = opts.Flag or opts.Name

	-- НЕ ЗАДАНО В СПЕЦИФИКАЦИИ: промежуток между дорожкой и числом (взято 8).
	local gap = 8
	local holder = New("Frame", {
		Size = UDim2.fromOffset(L.trackW + gap + 20, row.Height),
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		BackgroundTransparency = 1,
		Parent = row.Control,
	})

	-- НЕ ЗАДАНО В СПЕЦИФИКАЦИИ: зона захвата шире дорожки (4px мышью не поймать).
	local hit = New("TextButton", {
		Size = UDim2.fromOffset(L.trackW, 20),
		Position = UDim2.new(0, 0, 0.5, -10),
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		Text = "",
		Parent = holder,
	})

	local track = New("Frame", {
		Size = UDim2.fromOffset(L.trackW, L.trackH),
		Position = UDim2.new(0, 0, 0.5, -L.trackH / 2),
		BackgroundColor3 = Theme.bg1,
		BorderSizePixel = 0,
		Parent = holder,
	})
	Corner(track, L.trackR)

	local fill = New("Frame", {
		Size = UDim2.new((value - min) / math.max(max - min, 1), 0, 1, 0),
		BackgroundColor3 = win.Accent,
		BorderSizePixel = 0,
		Parent = track,
	})
	Corner(fill, L.trackR)
	MarkAccent(win, fill, "BackgroundColor3")

	local numLabel = New("TextLabel", {
		Size = UDim2.fromOffset(20, row.Height),
		Position = UDim2.fromOffset(L.trackW + gap, 0),
		BackgroundTransparency = 1,
		Font = Theme.Font,
		TextSize = L.fontRow,
		TextColor3 = Theme.text1,
		TextXAlignment = Enum.TextXAlignment.Right,
		Text = tostring(value),
		Parent = holder,
	})

	local function render()
		fill.Size = UDim2.new((value - min) / math.max(max - min, 1), 0, 1, 0)
		numLabel.Text = tostring(value)
	end

	local function quantize(raw)
		local v = min + math.floor((raw - min) / step + 0.5) * step
		return Clamp(v, min, max)
	end

	function ctl:Set(v, silent)
		v = quantize(Clamp(v, min, max))
		if v == value then return end
		value = v
		Library.Flags[id] = value
		render()
		if not silent and opts.Callback then opts.Callback(value) end
	end
	function ctl:Get() return value end
	function ctl:SetVisible(b) row:SetVisible(b) end

	local dragging = false
	local function updateFrom(px)
		local a = Clamp((px - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
		ctl:Set(min + a * (max - min))
	end

	Connect(hit.InputBegan, function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1
		or i.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			updateFrom(i.Position.X)
		end
	end)
	Connect(UserInputService.InputChanged, function(i)
		if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement
			or i.UserInputType == Enum.UserInputType.Touch) then
			updateFrom(i.Position.X)
		end
	end)
	Connect(UserInputService.InputEnded, function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1
		or i.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	Library.Flags[id] = value
	win._controls[id] = ctl
	render()
	return ctl
end

