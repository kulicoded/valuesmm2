--============================== УТИЛИТЫ ===============================

-- Список объектов, участвующих в затухании панели при открытии/закрытии.
local FadeList = {}

local function New(class, props, children)
	local inst = Instance.new(class)
	local parent
	if props then
		for k, v in pairs(props) do
			if k == "Parent" then parent = v else inst[k] = v end
		end
	end
	if children then
		for _, c in ipairs(children) do c.Parent = inst end
	end
	if parent then inst.Parent = parent end
	if inst:IsA("GuiObject") or inst:IsA("UIStroke") then
		table.insert(FadeList, inst)
	end
	return inst
end

local function Corner(parent, r)
	return New("UICorner", { CornerRadius = UDim.new(0, r), Parent = parent })
end

local function Round(parent) -- полностью скруглённый
	return New("UICorner", { CornerRadius = UDim.new(1, 0), Parent = parent })
end

local function Stroke(parent, color, thickness)
	return New("UIStroke", {
		Color = color or Theme.stroke,
		Thickness = thickness or 1,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = parent,
	})
end

local function Pad(parent, t, r, b, l)
	return New("UIPadding", {
		PaddingTop = UDim.new(0, t), PaddingRight = UDim.new(0, r),
		PaddingBottom = UDim.new(0, b), PaddingLeft = UDim.new(0, l),
		Parent = parent,
	})
end

local function ListLayout(parent, dir, padding, hAlign, vAlign)
	return New("UIListLayout", {
		FillDirection = dir,
		Padding = UDim.new(0, padding),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = hAlign or Enum.HorizontalAlignment.Left,
		VerticalAlignment = vAlign or Enum.VerticalAlignment.Top,
		Parent = parent,
	})
end

local function Tween(obj, props, dur, style, dir)
	local info = TweenInfo.new(
		dur or 0.12,
		style or Enum.EasingStyle.Quad,
		dir or Enum.EasingDirection.Out
	)
	local t = TweenService:Create(obj, info, props)
	t:Play()
	return t
end

local function Clamp(v, a, b)
	if v < a then return a elseif v > b then return b end
	return v
end

-- Верхний регистр с поддержкой кириллицы (string.upper её не берёт).
local function Upper(s)
	local out = {}
	for _, c in utf8.codes(s) do
		if c >= 1072 and c <= 1103 then c = c - 32
		elseif c == 1105 then c = 1025 end
		table.insert(out, utf8.char(c))
	end
	return string.upper(table.concat(out))
end

-- Имитация увеличенного межбуквенного интервала: в Roblox его нет, вставляем пробелы.
local function Spaced(s)
	local out = {}
	for _, c in utf8.codes(s) do table.insert(out, utf8.char(c)) end
	return table.concat(out, " ")
end

-- Иконка: картинка, если assetId задан, иначе квадрат-заглушка цвета иконки.
local function Icon(name, size, color, props)
	local base = {
		Size = UDim2.fromOffset(size, size),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
	}
	for k, v in pairs(props or {}) do base[k] = v end

	local id = Icons[name] or ""
	if id ~= "" then
		base.Image = id
		base.ImageColor3 = color
		base.ScaleType = Enum.ScaleType.Fit
		return New("ImageLabel", base)
	end
	base.BackgroundTransparency = 0
	base.BackgroundColor3 = color
	local f = New("Frame", base)
	Corner(f, 3) -- НЕ ЗАДАНО В СПЕЦИФИКАЦИИ: скругление заглушки иконки
	return f
end

local function IconColor(obj, color, dur)
	local prop = obj:IsA("ImageLabel") and "ImageColor3" or "BackgroundColor3"
	if dur then Tween(obj, { [prop] = color }, dur) else obj[prop] = color end
end

