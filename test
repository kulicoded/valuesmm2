		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		BackgroundColor3 = Theme.bg2,
		BorderSizePixel = 0,
		Parent = row.Control,
	})
	Corner(frame, 6)
	Stroke(frame)

	local tb = New("TextBox", {
		Size = UDim2.new(1, -16, 1, 0),
		Position = UDim2.fromOffset(8, 0),
		BackgroundTransparency = 1,
		Font = Theme.Font,
		TextSize = 13,
		TextColor3 = Theme.text0,
		PlaceholderColor3 = Theme.text3,
		PlaceholderText = opts.Placeholder or "",
		TextXAlignment = Enum.TextXAlignment.Left,
		ClearTextOnFocus = false,
		Text = value,
		Parent = frame,
	})

	function ctl:Set(v, silent)
		v = tostring(v)
		if v == value then return end
		value = v
		tb.Text = v
		Library.Flags[id] = v
		if not silent and opts.Callback then opts.Callback(v) end
	end
	function ctl:Get() return value end
	function ctl:SetVisible(b) row:SetVisible(b) end

	Connect(tb.FocusLost, function()
		if tb.Text ~= value then
			value = tb.Text
			Library.Flags[id] = value
			if opts.Callback then opts.Callback(value) end
		end
	end)

	Library.Flags[id] = value
	win._controls[id] = ctl
	return ctl
end

-------------------------------- KEYBIND -------------------------------
local function MakeKeybind(win, row, opts)
	local ctl = {}
	local id = opts.Flag or opts.Name
	local key = opts.Default
	local listening = false

	local box = New("TextButton", {
		Size = UDim2.fromOffset(110, 26),
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		BackgroundColor3 = Theme.bg1,
		AutoButtonColor = false,
		Text = "",
		BorderSizePixel = 0,
		Parent = row.Control,
	})
	Corner(box, 6)
	Stroke(box)
	Pad(box, 0, 8, 0, 8)

	local label = New("TextLabel", {
		Size = UDim2.new(1, -16, 1, 0),
		BackgroundTransparency = 1,
		Font = Theme.Font,
		TextSize = 13,
		TextColor3 = Theme.text1,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = key and key.Name or "",
		Parent = box,
	})
	Icon("chevron", 12, Theme.text2, {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Parent = box,
	})

	function ctl:Set(v, silent)
		if v == key then return end
		key = v
		Library.Flags[id] = key
		label.Text = key and key.Name or ""
		if not silent and opts.Callback then opts.Callback(key) end
	end
	function ctl:Get() return key end
	function ctl:SetVisible(b) row:SetVisible(b) end

	Connect(box.MouseButton1Click, function()
		if listening then return end
		listening = true
		label.Text = "..."
	end)

	Connect(UserInputService.InputBegan, function(i, processed)
		if not listening then return end
		if i.UserInputType ~= Enum.UserInputType.Keyboard then return end
		listening = false
		-- НЕ ЗАДАНО В СПЕЦИФИКАЦИИ: Escape отменяет назначение (иначе режим не выйти).
		if i.KeyCode == Enum.KeyCode.Escape then
			label.Text = key and key.Name or ""
			return
		end
		ctl:Set(i.KeyCode)
	end)

	Library.Flags[id] = key
	win._controls[id] = ctl
	return ctl
end

