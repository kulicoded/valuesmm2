-- Список рисуется в отдельном ScreenGui, чтобы карточка его не обрезала.
local function MakeDropdown(win, row, opts)
	local ctl = {}
	local options = opts.Options or {}
	local value = opts.Default or options[1] or ""
	local id = opts.Flag or opts.Name
	local open = false

	local box = New("TextButton", {
		Size = UDim2.fromOffset(110, 26),
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		BackgroundColor3 = Theme.bg1,
		AutoButtonColor = false,
		Text = "",
		BorderSizePixel = 0,
		Parent = row.Control,
	})
	Corner(box, 6)
	Stroke(box)
	Pad(box, 0, 8, 0, 8)

	local valueLabel = New("TextLabel", {
		Size = UDim2.new(1, -16, 1, 0),
		BackgroundTransparency = 1,
		Font = Theme.Font,
		TextSize = 13,
		TextColor3 = Theme.text1,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Text = tostring(value),
		Parent = box,
	})
	local chev = Icon("chevron", 12, Theme.text2, {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Parent = box,
	})

	-- сам список
	local list = New("Frame", {
		BackgroundColor3 = Theme.bg1,
		BorderSizePixel = 0,
		Visible = false,
		ZIndex = 10,
		Size = UDim2.fromOffset(110, 0),
		Parent = win.PopupGui,
	})
	Corner(list, 6)
	Stroke(list)
	local listScroll = New("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 2,
		ScrollBarImageColor3 = Theme.stroke,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ZIndex = 10,
		Parent = list,
	})
	ListLayout(listScroll, Enum.FillDirection.Vertical, 0)

	local rowsById = {}
	local function refreshMarks()
		for _, e in ipairs(rowsById) do
			e.check.Visible = (e.name == value)
		end
	end

	local function closeList()
		if not open then return end
		open = false
		list.Visible = false
	end

	local function openList()
		open = true
		-- НЕ ЗАДАНО В СПЕЦИФИКАЦИИ: максимум 6 видимых пунктов, дальше прокрутка.
		local h = math.min(#options, 6) * 26
		local pos = box.AbsolutePosition
		local size = box.AbsoluteSize
		local screen = win.Gui.AbsoluteSize
		local y = pos.Y + size.Y + 4
		if y + h > screen.Y then y = math.max(0, pos.Y - h - 4) end
		list.Position = UDim2.fromOffset(pos.X, y)
		list.Size = UDim2.fromOffset(math.max(size.X, 110), h)
		list.Visible = true
		refreshMarks()
	end

	for _, name in ipairs(options) do
		local item = New("TextButton", {
			Size = UDim2.new(1, 0, 0, 26),
			BackgroundColor3 = Theme.bg2,
			BackgroundTransparency = 1,
			AutoButtonColor = false,
			Text = "",
			BorderSizePixel = 0,
			ZIndex = 10,
			Parent = listScroll,
		})
		Pad(item, 0, 8, 0, 8)
		New("TextLabel", {
			Size = UDim2.new(1, -18, 1, 0),
			BackgroundTransparency = 1,
			Font = Theme.Font,
			TextSize = 13,
			TextColor3 = Theme.text1,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Text = name,
			ZIndex = 10,
			Parent = item,
		})
		local check = Icon("check", 12, win.Accent, {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, 0, 0.5, 0),
			Visible = false,
			ZIndex = 10,
			Parent = item,
		})
		MarkAccent(win, check, check:IsA("ImageLabel") and "ImageColor3" or "BackgroundColor3")
		table.insert(rowsById, { name = name, check = check })

		Connect(item.MouseEnter, function() item.BackgroundTransparency = 0 end)
		Connect(item.MouseLeave, function() item.BackgroundTransparency = 1 end)
		Connect(item.MouseButton1Click, function()
			ctl:Set(name)
			closeList()
		end)
	end

	function ctl:Set(v, silent)
		if v == value then return end
		value = v
		Library.Flags[id] = value
		valueLabel.Text = tostring(value)
		refreshMarks()
		if not silent and opts.Callback then opts.Callback(value) end
	end
	function ctl:Get() return value end
	function ctl:SetVisible(b) row:SetVisible(b) closeList() end

	Connect(box.MouseButton1Click, function()
		if open then closeList() else openList() end
	end)

	-- клик мимо списка закрывает его
	Connect(UserInputService.InputBegan, function(i)
		if not open then return end
		if i.UserInputType ~= Enum.UserInputType.MouseButton1
		and i.UserInputType ~= Enum.UserInputType.Touch then return end
		local p, s = list.AbsolutePosition, list.AbsoluteSize
		local m = i.Position
		local insideList = m.X >= p.X and m.X <= p.X + s.X and m.Y >= p.Y and m.Y <= p.Y + s.Y
		local bp, bs = box.AbsolutePosition, box.AbsoluteSize
		local insideBox = m.X >= bp.X and m.X <= bp.X + bs.X and m.Y >= bp.Y and m.Y <= bp.Y + bs.Y
		if not insideList and not insideBox then closeList() end
	end)

	table.insert(win._popups, closeList)
	Library.Flags[id] = value
	win._controls[id] = ctl
	return ctl
end

