--=========================== ХРАНИЛИЩЕ ПО УМОЛЧАНИЮ ===================

local function MakeMemoryStorage()
	local store = {}
	local order = {}
	return {
		save = function(name, data)
			if store[name] == nil then table.insert(order, name) end
			store[name] = { data = data, date = os.date("%d.%m.%Y %H:%M") }
		end,
		load = function(name)
			local e = store[name]
			return e and e.data or nil
		end,
		list = function()
			local out = {}
			for _, name in ipairs(order) do
				table.insert(out, { name = name, date = store[name].date })
			end
			return out
		end,
		delete = function(name)
			store[name] = nil
			for i, n in ipairs(order) do
				if n == name then table.remove(order, i) break end
			end
		end,
	}
end

