local function CollectFade(root)
	local items = {}
	for i = #FadeList, 1, -1 do
		local o = FadeList[i]
		if not o.Parent and o ~= root then
			table.remove(FadeList, i)
		elseif o == root or o:IsDescendantOf(root) then
			if o:IsA("UIStroke") then
				table.insert(items, { o = o, p = "Transparency", b = o.Transparency })
			else
				table.insert(items, { o = o, p = "BackgroundTransparency", b = o.BackgroundTransparency })
				if o:IsA("TextLabel") or o:IsA("TextBox") or o:IsA("TextButton") then
					table.insert(items, { o = o, p = "TextTransparency", b = o.TextTransparency })
				end
				if o:IsA("ImageLabel") or o:IsA("ImageButton") then
					table.insert(items, { o = o, p = "ImageTransparency", b = o.ImageTransparency })
				end
			end
		end
	end
	return items
end

function Window:Toggle(state)
	if state == nil then state = not self.Open end
	if state == self.Open and self._animVal then return end
	self.Open = state

	for _, close in ipairs(self._popups) do close() end

	-- если анимация уже идёт — переиспользуем снимок, иначе снимаем текущий
	if not self._fadeItems then
		self._fadeItems = CollectFade(self.Root)
	end
	local items = self._fadeItems

	if self._animVal then
		self._animVal:Destroy()
		self._animVal = nil
	end

	local nv = Instance.new("NumberValue")
	nv.Value = state and 0 or 1
	self._animVal = nv

	local function apply(a)
		self.Scale.Scale = 0.96 + 0.04 * a
		for _, it in ipairs(items) do
			if it.o.Parent then it.o[it.p] = 1 - a * (1 - it.b) end
		end
	end

	if state then
		self.Root.Visible = true
		apply(0)
	end
	nv.Changed:Connect(apply)

	local dur = state and 0.15 or 0.12
	local dir = state and Enum.EasingDirection.Out or Enum.EasingDirection.In
	local t = TweenService:Create(nv,
		TweenInfo.new(dur, Enum.EasingStyle.Quad, dir),
		{ Value = state and 1 or 0 })
	t.Completed:Connect(function()
		if self._animVal ~= nv then return end
		-- вернуть исходные значения прозрачности и спрятать панель
		for _, it in ipairs(items) do
			if it.o.Parent then it.o[it.p] = it.b end
		end
		self.Scale.Scale = 1
		self.Root.Visible = state
		nv:Destroy()
		self._animVal = nil
		self._fadeItems = nil
	end)
	t:Play()
end

function Window:Destroy()
	if self._animVal then self._animVal:Destroy() self._animVal = nil end
	if self.PopupGui then self.PopupGui:Destroy() end
	if self.Gui then self.Gui:Destroy() end
	for i, w in ipairs(Library._windows) do
		if w == self then table.remove(Library._windows, i) break end
	end
end

function Library:Destroy()
	for _, c in ipairs(self._connections) do
		if c.Connected then c:Disconnect() end
	end
	table.clear(self._connections)
	for i = #self._windows, 1, -1 do
		self._windows[i]:Destroy()
	end
	table.clear(self.Flags)
	table.clear(FadeList)
end

